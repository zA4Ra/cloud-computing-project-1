# Function image built the same way as our Task 2 Dockerfile (before Task 5)
# Only kept to compare image sizes
# Build with: docker build -f Dockerfile.basic -t diet-function:basic .
FROM python:3.9-slim

WORKDIR /app
COPY . /app
RUN pip install pandas matplotlib seaborn azure-storage-blob

CMD ["python", "lambda_function.py"]
